<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <IsPackable>true</IsPackable>

        <!-- NuGet metadata -->
        <PackageId>OpenccJiebaLib</PackageId>
        <Title>OpenccJieba C API Interop Library</Title>
        <Authors>laisuk</Authors>
        <Description>opencc-jieba-rs Rust based C API .NET interop library for Chinese text conversion and segmentation between Traditional and Simplified Chinese</Description>
        <PackageTags>opencc;chinese;jieba;traditional;simplified;capi</PackageTags>
        <Copyright>laisuk</Copyright>

        <PackageProjectUrl>https://github.com/laisuk/OpenccJiebaLib</PackageProjectUrl>
        <RepositoryUrl>https://github.com/laisuk/OpenccJiebaLib</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <!-- README packaged to root, so reference just "README.md" -->
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Symbols -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <!-- <IncludeSource>true</IncludeSource> -->

        <!-- XML docs -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Versioning -->
        <AssemblyVersion>1.4.1.0</AssemblyVersion>
        <FileVersion>1.4.1.0</FileVersion>
        <Version>1.4.1</Version>

        <PackageReleaseNotes>
            v1.4.1

            - Added NormalizeCompat for CJK Compatibility Ideographs and NormalizeCompatExtended for curated extended compatibility mappings.
            - Added DeTofu and DeTofuLevel with inclusive Extension B through I display fallback thresholds; unmapped characters are preserved.
            - Transforms are optional: normalize before conversion and apply DeTofu afterward. Existing conversion behavior is unchanged.
            - Added Unicode/NUL and level validation, synchronized disposal protection, and regression coverage.
            - Expanded XML documentation for native APIs, ownership, failure results, and transform contracts.
            - Transform APIs require native v0.8.1 or later with the corresponding exports; other bundled RID binaries still await synchronization.
        </PackageReleaseNotes>

        <PackageIcon>icon.png</PackageIcon>

        <!-- Optional: helpful for deterministic CI builds -->
        <!-- <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild> -->
    </PropertyGroup>

    <!-- Pack README, LICENSE and icon file at package root -->
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\LICENSE" Pack="true" PackagePath="\"/>
        <None Include="assets\icon.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!-- Pack native assets to runtimes/ paths -->
    <ItemGroup>
        <None Include="runtimes\win-x64\native\opencc_jieba_capi.dll"
              Pack="true"
              PackagePath="runtimes/win-x64/native/"/>
        <None Include="runtimes\linux-arm64\native\libopencc_jieba_capi.so"
              Pack="true"
              PackagePath="runtimes/linux-arm64/native/"/>
        <None Include="runtimes\linux-x64\native\libopencc_jieba_capi.so"
              Pack="true"
              PackagePath="runtimes/linux-x64/native/"/>
        <None Include="runtimes\osx-arm64\native\libopencc_jieba_capi.dylib"
              Pack="true"
              PackagePath="runtimes/osx-arm64/native/"/>

        <!-- If any Intel mac builds, include this too -->
        <!--
        <None Include="runtimes\osx-x64\native\libopencc_jieba_capi.dylib"
              Pack="true"
              PackagePath="runtimes/osx-x64/native/" />
        -->
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Memory" Version="4.6.3"/>
    </ItemGroup>

</Project>
