<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <IsPackable>true</IsPackable>

        <!-- NuGet metadata -->
        <PackageId>OpenccJiebaLib</PackageId>
        <Title>OpenccJieba C API Interop Library</Title>
        <Authors>laisuk</Authors>
        <Description>opencc-jieba-rs Rust based C API .NET interop library for Chinese text conversion and segmentation between Traditional and Simplified Chinese</Description>
        <PackageTags>opencc;chinese;jieba;traditional;simplified;capi</PackageTags>
        <Copyright>laisuk</Copyright>

        <PackageProjectUrl>https://github.com/laisuk/OpenccJiebaLib</PackageProjectUrl>
        <RepositoryUrl>https://github.com/laisuk/OpenccJiebaLib</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <!-- README packaged to root, so reference just "README.md" -->
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Symbols -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <!-- <IncludeSource>true</IncludeSource> -->

        <!-- XML docs -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- (Optional) don’t warn about undocumented public members -->
        <NoWarn>$(NoWarn);1591</NoWarn>

        <!-- Versioning -->
        <AssemblyVersion>1.2.2.0</AssemblyVersion>
        <FileVersion>1.2.2.0</FileVersion>
        <Version>1.2.2</Version>

        <PackageReleaseNotes>v1.2.2
            
            - Update native opencc-jieba-capi to v0.7.5
            - Added param `separator` in segment mode `tag` when joined as string
        </PackageReleaseNotes>

        <PackageIcon>icon.png</PackageIcon>

        <!-- Optional: helpful for deterministic CI builds -->
        <!-- <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild> -->
    </PropertyGroup>

    <!-- Pack README, LICENSE and icon file at package root -->
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\LICENSE" Pack="true" PackagePath="\"/>
        <None Include="assets\icon.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!-- Pack native assets to runtimes/ paths -->
    <ItemGroup>
        <None Include="runtimes\win-x64\native\opencc_jieba_capi.dll"
              Pack="true"
              PackagePath="runtimes/win-x64/native/"/>
        <None Include="runtimes\linux-arm64\native\libopencc_jieba_capi.so"
              Pack="true"
              PackagePath="runtimes/linux-arm64/native/"/>
        <None Include="runtimes\linux-x64\native\libopencc_jieba_capi.so"
              Pack="true"
              PackagePath="runtimes/linux-x64/native/"/>
        <None Include="runtimes\osx-arm64\native\libopencc_jieba_capi.dylib"
              Pack="true"
              PackagePath="runtimes/osx-arm64/native/"/>

        <!-- If any Intel mac builds, include this too -->
        <!--
        <None Include="runtimes\osx-x64\native\libopencc_jieba_capi.dylib"
              Pack="true"
              PackagePath="runtimes/osx-x64/native/" />
        -->
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Memory" Version="4.6.3"/>
    </ItemGroup>

</Project>
